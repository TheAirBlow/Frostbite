# Runtime data and secrets
/data/
/certs/
.env
.env.*
!.env.example

# Embedded frontend build output
/internal/frontend/dist/*
!/internal/frontend/dist/.gitkeep

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
go.work
go.work.sum
/bin/
/dist/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

