# Build one agent image per core: docker build -f Dockerfile.agent --target xray .
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

FROM build AS build-xray
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent-xray

FROM build AS build-singbox
ARG SINGBOX_VERSION=1.14.3
ARG SINGBOX_TAGS="with_quic,with_utls,with_gvisor,with_wireguard,with_acme,with_clash_api"
RUN CGO_ENABLED=0 go build -trimpath -tags "${SINGBOX_TAGS}" \
    -ldflags="-s -w -X github.com/sagernet/sing-box/constant.Version=${SINGBOX_VERSION}" -o /out/agent ./cmd/agent-singbox

FROM build AS build-edge
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent-edge

FROM build AS build-mtproto
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent-mtproto

FROM build AS build-turnable
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent-turnable

FROM alpine:3.22 AS fetch-xray
ARG XRAY_VERSION=v26.3.27
ARG TARGETARCH
RUN apk add --no-cache curl unzip \
    && case "${TARGETARCH}" in arm64) f=Xray-linux-arm64-v8a.zip ;; *) f=Xray-linux-64.zip ;; esac \
    && curl -fsSL "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/${f}" -o /xray.zip \
    && unzip -q /xray.zip -d /xray

FROM alpine:3.22 AS base
RUN apk add --no-cache ca-certificates tzdata
ENV FROSTBITE_DATA_DIR=/data
VOLUME ["/data"]

FROM base AS xray
COPY --from=fetch-xray /xray/xray /usr/local/bin/xray
COPY --from=fetch-xray /xray/geoip.dat /xray/geosite.dat /usr/local/share/xray/
ENV XRAY_LOCATION_ASSET=/usr/local/share/xray
COPY --from=build-xray /out/agent /usr/local/bin/agent
ENTRYPOINT ["agent"]

FROM base AS singbox
COPY --from=build-singbox /out/agent /usr/local/bin/agent
ENTRYPOINT ["agent"]

FROM base AS edge
COPY --from=build-edge /out/agent /usr/local/bin/agent
ENTRYPOINT ["agent"]

FROM base AS mtproto
COPY --from=build-mtproto /out/agent /usr/local/bin/agent
ENTRYPOINT ["agent"]

FROM base AS turnable
COPY --from=build-turnable /out/agent /usr/local/bin/agent
ENTRYPOINT ["agent"]
