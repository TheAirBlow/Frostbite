# Postgres password, used by the postgres and panel services.
POSTGRES_PASSWORD=changeme

# Where users and nodes reach the panel, e.g. https://panel.example.com. Leave empty to guess from the request.
FROSTBITE_PUBLIC_URL=

# Host port of the web interface. The panel itself is never published.
FROSTBITE_PORT=8080

# First owner account. A random password is printed in the panel log when this stays empty.
FROSTBITE_ADMIN_USER=admin
FROSTBITE_ADMIN_PASS=

# Set to "true" once the panel is served over HTTPS.
FROSTBITE_COOKIE_SECURE=false

# Daemon tokens for agents running next to the panel (profiles "xray" and "singbox").
# FROSTBITE_XRAY_TOKEN=
# FROSTBITE_SINGBOX_TOKEN=
# FROSTBITE_EDGE_TOKEN=
# FROSTBITE_MTPROTO_TOKEN=
# FROSTBITE_TURNABLE_TOKEN=

# Monitoring, started with: docker compose --profile monitoring up -d
GRAFANA_PASSWORD=admin
# PROMETHEUS_RETENTION=1y
# One set of series per user in /metrics (user names become labels). Set to false on very large installs.
# FROSTBITE_METRICS_PER_USER=true
